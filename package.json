{
  "name": "timbersense",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "tsc -b --noEmit && biome check src/",
    "lint": "biome check src/ --write",
    "sample": "python3 tools/make_sample.py testdata/fariy_1_test public/data/plots/sample",
    "plot:export": "python3 tools/prepare_plot.py testdata/fariy_1_test public/data/plots/fariy_1_test",
    "plot:validate": "python3 tools/validate_plot.py"
  },
  "dependencies": {
    "@headlessui/react": "~2.2.9",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.539.0",
    "ol": "~10.7.0",
    "react": "~19.1.1",
    "react-dom": "~19.1.1",
    "react-router-dom": "~7.9.2",
    "recharts": "^3.10.1",
    "three": "^0.180.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.2.4",
    "@tailwindcss/vite": "~4.1.13",
    "@types/node": "^22.20.5",
    "@types/react": "~19.1.1",
    "@types/react-dom": "~19.1.1",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "~5.0.3",
    "tailwindcss": "~4.1.13",
    "typescript": "~5.9.2",
    "vite": "~7.1.7",
    "vite-plugin-svgr": "~4.3.0"
  }
}
